{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug UI (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AudioBatchConverter.UI/bin/Debug/net8.0-windows/AudioBatchConverter.UI.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Debug UI with folder",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AudioBatchConverter.UI/bin/Debug/net8.0-windows/AudioBatchConverter.UI.exe",
      "args": ["${input:folderPath}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ],
  "inputs": [
    {
      "id": "folderPath",
      "type": "promptString",
      "description": "Path to folder or audio file to convert",
      "default": "C:\\Music"
    }
  ]
}
