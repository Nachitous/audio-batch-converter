PUID=1000
PGID=1000
TZ=UTC

# Root path the web UI is allowed to browse and convert within.
# Set to a common parent to reach multiple libraries in one session.
BROWSER_ROOT=/volume1

# Volume mounts (host paths — must be accessible to PUID:PGID)
MUSIC_DIR=/volume1/Music
DOWNLOADS_DIR=/volume1/downloads

# Host port for the web UI (default: 8080)
PORT=8080
